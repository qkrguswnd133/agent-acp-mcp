// Documentation example only: use the matching .json for deployment (JSON disallows comments).
// auto requires the parent to choose concrete model/effort values and pass selection_reason.
{
  "mcpServers": {
    "agent": {
      "command": "C:/Program Files/nodejs/node.exe",
      "args": [
        "C:/Users/YOUR_NAME/AppData/Local/Programs/Agent ACP MCP/dist/src/index.js"
      ],
      "env": {
        // New worktrees default to %USERPROFILE%/.agent-acp/worktrees.
        // Optional absolute root; changing it does not migrate existing TEMP worktrees:
        // "AGENT_MCP_WORKTREE_DIR": "D:/AgentWorktrees",
        // Bundled portable PowerShell 7.6.6 is available. Optional native PowerShell 7+ override:
        // "CODEX_POWERSHELL_PATH": "C:/Program Files/PowerShell/7/pwsh.exe",
        // Invalid explicit/WindowsApps paths fail; no Windows PowerShell 5.1 fallback.
        // Persistent default: "true" allows self-provider calls in auto/explicit routing; "false" blocks.
        "ALLOW_SELF_PROVIDER": "false",
        "GROK_ENABLED": "true",
        "CLAUDE_ENABLED": "true",
        "CODEX_ENABLED": "true",
        "GROK_MODEL": "auto",
        "GROK_EFFORT": "auto",
        // standard only; independent Grok speed control is unverified.
        "GROK_SPEED": "standard",
        "CLAUDE_MODEL": "auto",
        // Claude CLI choices: low, medium, high, xhigh, max (model/version dependent).
        "CLAUDE_EFFORT": "auto",
        // standard (default), fast for supported models; Fast uses usage credits.
        "CLAUDE_SPEED": "standard",
        "CODEX_MODEL": "auto",
        // Codex model/client choices: low, medium, high, xhigh, max, ultra (check model support).
        "CODEX_EFFORT": "auto",
        // standard (default), fast, ultrafast when advertised by agent_models.
        "CODEX_SPEED": "standard",
        // Optional new-worktree build/.gradle artifact cleanup after fresh idle checks.
        "AGENT_MCP_AUTO_CLEAN_IGNORED_ARTIFACTS": "false",
        "CODEX_WINDOWS_SANDBOX": "unelevated",
        "CODEX_IMPLEMENT_SANDBOX": "workspace-write"
      }
    }
  }
}



